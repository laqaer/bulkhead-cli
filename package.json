{
  "name": "@bulkheadtools/cli",
  "version": "0.2.0",
  "description": "Claude Code hooks that keep receipts: deterministic guardrails (incident-pack command rules, protected paths, $ caps, loop freeze), completion verification, and a tamper-evident ledger. One command. Containment and evidence — not a firewall.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bulkhead": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laqaer/bulkhead-cli.git"
  },
  "homepage": "https://github.com/laqaer/bulkhead-cli#readme",
  "bugs": {
    "url": "https://github.com/laqaer/bulkhead-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude-code",
    "claude-code-hooks",
    "hooks",
    "pretooluse",
    "guardrails",
    "ai-agents",
    "coding-agent",
    "audit-log",
    "ledger",
    "cost-limit",
    "completion-verification",
    "dangerously-skip-permissions",
    "auto-mode",
    "safety",
    "containment"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
